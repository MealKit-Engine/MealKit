# MealKit table (Action). Edit it in the editor's [Tables] panel or import a CSV there.

row move
kind Axis2
label Move
keys W S A D Up Down Left Right
pad LeftStick

row jump
label Jump
keys Space
pad A

row push
label Push
mouse Left
pad RightTrigger X

row orbit
label Turn camera (hold)
mouse Right

row look
kind Delta2
label Turn camera (mouse)
mouse Move

row turn
kind Delta2
label Turn camera (stick)
pad RightStick
rate 500

row zoom
kind Delta
label Zoom
mouse Wheel
pad DPadUp -DPadDown
rate 4

row debug.shockwave
label Debug: shockwave
keys F8

row menu.settings
label Settings
keys F10

row menu.pause
label Pause menu
keys Escape
pad Start

row chat.open
label Chat
keys Enter

row ui.up
label Menu up
keys Up
pad DPadUp

row ui.down
label Menu down
keys Down
pad DPadDown

row ui.left
label Menu left
keys Left
pad DPadLeft

row ui.right
label Menu right
keys Right
pad DPadRight

row ui.confirm
label Menu confirm
keys Enter
pad A

row ui.back
label Menu back
keys Escape
pad B
