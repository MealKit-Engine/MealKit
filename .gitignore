# Only output folders at the repo top level (Windows is case-insensitive, so build/ also blocked third_party/JoltPhysics/Build/)
/build/
/out/
/export/
# Reference sample projects (samples/<name>): editor/play/cache output and Export folders
/samples/*/build/
/samples/*/export/
.vs/
# Only screenshots/captures (textures and icons are committed)
/screenshot*.png
/capture*.png
/out*.png
*.autosave
mealkit_editor.ini
# Steamworks SDK: not committed to a public repo per Valve's terms (docs repo "Manual > Multiplayer and determinism > Steamworks")
third_party/steamworks/
# EOS SDK and Epic Developer Portal values (credentials.txt): not committed per Epic's terms, and client secrets don't go in the repo
third_party/eos/
__pycache__/
