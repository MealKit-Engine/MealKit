# MealKit shared editor settings (shared by the engine and game projects). C++ formatting rules are in .clang-format.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# External libraries are left as in the original
[third_party/**]
charset = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
