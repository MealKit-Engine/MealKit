# MealKit 편집기 공통 설정 (엔진과 게임 프로젝트 공통). C++ 서식 규칙은 .clang-format.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# 외부 라이브러리는 원본 그대로 둔다
[third_party/**]
charset = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
