{
    // F5: builds the selected configuration and runs it in the debugger (needs the C/C++ extension ms-vscode.cpptools)
    "version": "0.2.0",
    "configurations": [
        {
            // Opens the engine sample project in the general-purpose editor (RelWithDebInfo: optimized + debug info)
            "name": "Editor",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Editor/bin/MealKitEditor.exe",
            "args": ["--project", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Editor"
        },
        {
            // Run without a project: project manager
            "name": "Editor (project manager)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Editor/bin/MealKitEditor.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Editor"
        },
        {
            "name": "Game (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/bin/sandbox.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Debug"
        },
        {
            "name": "Game Host (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/bin/sandbox.exe",
            "args": ["--host", "--local"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Release"
        },
        {
            "name": "Game Join 127.0.0.1 (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/bin/sandbox.exe",
            "args": ["--join", "127.0.0.1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
