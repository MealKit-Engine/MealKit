{
    // Ctrl+Shift+B: 기본 빌드 (Release). 다른 작업은 Ctrl+Shift+P → "Tasks: Run Task"
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Release"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Debug"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Profile (Tracy)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Profile"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Editor",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Editor"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Open Editor",
            "type": "shell",
            "command": "${workspaceFolder}\\editor.bat",
            "dependsOn": "Build Editor",
            "problemMatcher": []
        },
        {
            "label": "Multiplayer Determinism Test",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\mp_test.ps1", "-Clients", "3", "-Ticks", "900"],
            "dependsOn": "Build Release",
            "problemMatcher": []
        }
    ]
}
