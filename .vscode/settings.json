{
    // 코드 자동완성/이동: 빌드할 때 만들어지는 compile_commands.json을 쓴다 (먼저 build.bat Editor로 한 번 빌드할 것. 에디터 코드까지 들어 있다)
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Editor/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++20",
    "files.encoding": "utf8",
    "files.associations": {
        "*.scene": "plaintext",
        "*.hlsl": "hlsl"
    },
    "search.exclude": {
        "build/**": true,
        "third_party/**": true
    }
}
