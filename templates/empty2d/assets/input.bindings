# MealKit table (Action). Edit it in the editor's [Tables] panel or import a CSV there.
@format table 1

row move
kind Axis2
label Move
keys W S A D Up Down Left Right
pad LeftStick

row jump
label Jump
keys Space W Up
pad A

row zoom
kind Delta
label Zoom
mouse Wheel
pad DPadUp -DPadDown
rate 4

row menu.settings
label Settings
keys F10

row menu.pause
label Pause menu
keys Escape
pad Start

row chat.open
label Chat
keys Enter

row ui.up
label Menu up
keys Up
pad DPadUp

row ui.down
label Menu down
keys Down
pad DPadDown

row ui.left
label Menu left
keys Left
pad DPadLeft

row ui.right
label Menu right
keys Right
pad DPadRight

row ui.confirm
label Menu confirm
keys Enter
pad A

row ui.back
label Menu back
keys Escape
pad B
