# MealKit UI (hand-written): HUD during a match. View model: HudVm (source/view/Hud.h). Text: assets/strings.
@format ui 1
board hud 1920 1080
  frame timePanel
    pos 840 24
    size 240 hug
    constraints center top
    layout row
    justify center
    padding 8 16
    fill $panel
    radius $radius
    text time
      content {time:time}
      fontSize 40
      color $text
    end
  end
end
