{
    // Code completion/navigation: uses compile_commands.json generated by the build (build once first).
    // Engine headers (@MEALKIT_ROOT_FWD@/engine/src) are found from here too.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Editor/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++20",
    "files.encoding": "utf8",
    // Formats with .clang-format rules on save (the clang-format bundled with the C/C++ extension)
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "[cpp]": {
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.formatOnSave": true
    },
    "files.associations": {
        "*.scene": "plaintext"
    },
    "search.exclude": {
        "build/**": true,
        "export/**": true
    }
}
