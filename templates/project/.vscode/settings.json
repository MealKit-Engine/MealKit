{
    // 코드 자동완성/이동: 빌드할 때 만들어지는 compile_commands.json을 쓴다 (먼저 한 번 빌드할 것).
    // 엔진 헤더(@MEALKIT_ROOT_FWD@/engine/src)도 여기서 찾아간다.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Editor/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++20",
    "files.encoding": "utf8",
    // 저장할 때 .clang-format 규칙으로 서식을 맞춘다 (C/C++ 확장에 들어 있는 clang-format)
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "[cpp]": {
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.formatOnSave": true
    },
    "files.associations": {
        "*.scene": "plaintext"
    },
    "search.exclude": {
        "build/**": true,
        "export/**": true
    }
}
