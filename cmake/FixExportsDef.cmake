# Removes bad lines from the exports.def generated by WINDOWS_EXPORT_ALL_SYMBOLS for mealkit.dll (PRE_LINK, cmake -P).
# MSVC CRT weak alias symbols (_Avx2WmemEnabledWeakValue etc.) come out as empty alias lines like "==" and break the link.
# Input: DEF_FILE
if(NOT EXISTS "${DEF_FILE}")
    return()
endif()
file(STRINGS "${DEF_FILE}" lines)
set(out "")
foreach(line IN LISTS lines)
    string(STRIP "${line}" stripped)
    # Drop lines with only = and no name, and CRT-internal symbols (no reason to export them)
    if(stripped MATCHES "^=+$" OR stripped MATCHES "^(_Avx2WmemEnabledWeakValue|__isa_available_default)")
        continue()
    endif()
    string(APPEND out "${line}\n")
endforeach()
file(WRITE "${DEF_FILE}" "${out}")
